@inherits LayoutComponentBase

<div class="page">
    <header class="top-row ps-3">
        <NavMenu />
    </header>

    <main>
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ett oväntat fel har inträffat. Försök att uppdatera sidan. Om felet kvarstår, kontakta systemadministratören och ge informationen nedan.    
    <a href="." class="reload">Ladda om</a>
    <span class="dismiss">Stäng</span>
</div>

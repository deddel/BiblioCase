@inject IHttpClientFactory HttpClientFactory

@page "/authors"
@attribute [StreamRendering]
@rendermode InteractiveServer

<PageTitle>Författare</PageTitle>

<h1>Författarna du borde läsa</h1>

@if (_authors == null)
{
    <p><em>Loading...</em></p>
}
else
{

    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header">
                    <span>Alla författare</span>
                </div>

                <div class="card-body p-0">
                    <table class="table table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Författare</th>
                                <th class="text-end">Info</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var author in _authors)
                            {
                                <tr>
                                    <td>@GetAuthorName(author)</td>
                                    <td class="text-end">
                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm"
                                            title="Visa"
                                            aria-label="Visa"
                                            @onclick="() => ShowAuthor(author)">
                                            <i class="bi bi-eye" aria-hidden="true"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            @if (_selectedAuthor is not null)
            {
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h3 class="h5 mb-3">@GetAuthorName(_selectedAuthor)</h3>

                        @if (!string.IsNullOrWhiteSpace(_selectedAuthor.Biography))
                        {
                            <p class="mb-0">@_selectedAuthor.Biography</p>
                        }
                        else
                        {
                            <p class="text-muted mb-0">
                                Ingen biografi finns registrerad.
                            </p>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-body text-muted">
                        Välj en författare för att se information här.
                    </div>
                </div>
            }
        </div>
    </div>

}


@code {
    private List<AuthorDto>? _authors;
    private AuthorDto? _selectedAuthor;

    private void ShowAuthor(AuthorDto author)
    {
        _selectedAuthor = author;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAuthorsAsync();
    }

    private async Task LoadAuthorsAsync()
    {
        var client = HttpClientFactory.CreateClient("BiblioCase.Api");
        _authors = await client.GetFromJsonAsync<List<AuthorDto>>("authors");
    }

    private static string GetAuthorName(AuthorDto author)
    {
        return string.Join(' ', new[] { author.FirstName, author.LastName }
            .Where(name => !string.IsNullOrWhiteSpace(name)));
    }

}
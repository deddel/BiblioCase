@inject IHttpClientFactory HttpClientFactory

@page "/books"
@attribute [StreamRendering]
@rendermode InteractiveServer

<PageTitle>Böckerna du borde läsa</PageTitle>

<h1>Böckerna du borde läsa</h1>

@if (_books == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="row g-4">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span>Alla böcker</span>
                </div>

                <div class="card-body p-0">
                    <div class="p-2 border-bottom">
                        <input type="search"
                               class="form-control form-control-sm"
                               placeholder="Sök på titel eller författare"
                               aria-label="Sök böcker"
                               @bind="_searchText"
                               @bind:event="oninput"
                               @bind:after="() => _page = 1" />
                    </div>

                    <table class="table table-striped mb-0">
                        <thead>
                            <tr>
                                <th>Titel</th>
                                <th>Författare</th>
                                <th>År</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var book in PagedBooks)
                            {
                                <tr class="@(book.Id == _viewedBookId ? "table-active" : null)">
                                    <td>@book.Title</td>
                                    <td>@GetAuthorName(book.Author)</td>
                                    <td>@(book.FirstPublicationYear?.ToString() ?? "")</td>
                                    <td class="text-end text-nowrap">
                                        <button type="button"
                                                class="btn btn-outline-primary btn-sm"
                                                title="Visa"
                                                aria-label="Visa"
                                                @onclick="() => _viewedBookId = book.Id">
                                            <i class="bi bi-eye" aria-hidden="true"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                            @if (FilteredBooks.Count == 0)
                            {
                                <tr>
                                    <td colspan="4" class="text-muted">Inga böcker hittades.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (TotalPages > 1)
                {
                    <div class="card-footer d-flex justify-content-between align-items-center">
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                disabled="@(CurrentPage == 1)"
                                @onclick="() => _page = CurrentPage - 1">
                            Föregående
                        </button>
                        <small class="text-muted">Sida @CurrentPage av @TotalPages</small>
                        <button type="button"
                                class="btn btn-outline-secondary btn-sm"
                                disabled="@(CurrentPage == TotalPages)"
                                @onclick="() => _page = CurrentPage + 1">
                            Nästa
                        </button>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-body">
                    @if (ViewedBook is { } viewed)
                    {
                        <h2 class="h4 book-title">@viewed.Title</h2>
                        <p class="text-muted mb-3">
                            @GetAuthorName(viewed.Author)@(viewed.FirstPublicationYear is { } year ? $" · {year}" : "")
                        </p>

                        @if (!string.IsNullOrWhiteSpace(viewed.Synopsis))
                        {
                            <h3 class="detail-label">Synopsis</h3>
                            <p>@viewed.Synopsis</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(viewed.Author.Biography))
                        {
                            <h3 class="detail-label">Om författaren</h3>
                            <p class="mb-0">@viewed.Author.Biography</p>
                        }
                    }
                    else
                    {
                        <p class="mb-0">Välj en bok för att se information här.</p>
                    }
                </div>
            </div>
        </div>
    </div>
}



@code {
    private List<BookDto>? _books;
    private List<AuthorDto> _authors = [];
    private int? _viewedBookId;
    private string _searchText = "";
    private int _page = 1;
    private const int PageSize = 15;



    private List<BookDto> FilteredBooks => (_books ?? [])
        .Where(book => string.IsNullOrWhiteSpace(_searchText) ||
                       book.Title.Contains(_searchText.Trim(), StringComparison.CurrentCultureIgnoreCase) ||
                       GetAuthorName(book.Author).Contains(_searchText.Trim(), StringComparison.CurrentCultureIgnoreCase))
        .ToList();

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredBooks.Count / (double)PageSize));

    private int CurrentPage => Math.Clamp(_page, 1, TotalPages);

    private IEnumerable<BookDto> PagedBooks => FilteredBooks.Skip((CurrentPage - 1) * PageSize).Take(PageSize);

    private BookDto? ViewedBook => _books?.FirstOrDefault(book => book.Id == _viewedBookId);

    protected override async Task OnInitializedAsync()
    {
        HttpClient client = HttpClientFactory.CreateClient("BiblioCase.Api");

        _books = await client.GetFromJsonAsync<List<BookDto>>("books");
        _authors = await client.GetFromJsonAsync<List<AuthorDto>>("authors") ?? [];
    }




    private static string GetAuthorName(AuthorDto author)
    {
        return string.Join(' ', new[] { author.FirstName, author.LastName }
            .Where(name => !string.IsNullOrWhiteSpace(name)));
    }


}
@inject IHttpClientFactory HttpClientFactory

@page "/books"
@attribute [StreamRendering]
@rendermode InteractiveServer

<PageTitle>Hundra böcker du borde läsa</PageTitle>

<h1>Hundra böcker du borde läsa</h1>

@if (books == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="card shadow-sm">
        <div class="card-header d-flex justify-content-between align-items-center">
            <span>Alla böcker</span>
            <button type="button"
                    class="btn btn-primary btn-sm"
                    data-bs-toggle="modal"
                    data-bs-target="#addBookModal">
                Lägg till bok
            </button>
        </div>

        <div class="card-body p-0">
            <table class="table table-striped mb-0">
                <thead>
                    <tr>
                        <th>Titel</th>
                        <th>Författare</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var book in books)
                    {
                        <tr>
                            <td>@book.Title</td>
                            <td>@book.Author</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="modal fade" id="addBookModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title">Lägg till bok</h5>
                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">
                @if (!string.IsNullOrWhiteSpace(errorMessage))
                {
                    <div class="alert alert-danger" role="alert">@errorMessage</div>
                }

                <div class="mb-3">
                    <label for="bookTitle" class="form-label">Titel</label>
                    <input id="bookTitle"
                           class="form-control"
                           @bind="newBook.Title"
                           disabled="@isSaving" />
                </div>

                <div class="mb-3">
                    <label for="bookAuthor" class="form-label">Författare</label>
                    <input id="bookAuthor"
                           class="form-control"
                           @bind="newBook.AuthorName"
                           disabled="@isSaving" />
                </div>
            </div>

            <div class="modal-footer">
                <button type="button"
                        class="btn btn-secondary"
                        data-bs-dismiss="modal">
                    Avbryt
                </button>

                <button type="button"
                        class="btn btn-primary"
                        @onclick="CreateBookAsync"
                        disabled="@isSaving">
                    @(isSaving ? "Sparar..." : "Spara bok")
                </button>
            </div>

        </div>
    </div>
</div>

@code {
    private List<BookDto>? books;
    private CreateBookRequest newBook = new();
    private string? errorMessage;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        HttpClient client = HttpClientFactory.CreateClient("BiblioCase.Api");

        books = await client.GetFromJsonAsync<List<BookDto>>("books");
    }

    private async Task CreateBookAsync()
    {
        errorMessage = null;

        if (string.IsNullOrWhiteSpace(newBook.Title) || string.IsNullOrWhiteSpace(newBook.AuthorName))
        {
            errorMessage = "Fyll i både titel och författare.";
            return;
        }

        isSaving = true;

        try
        {
            HttpClient client = HttpClientFactory.CreateClient("BiblioCase.Api");
            HttpResponseMessage response = await client.PostAsJsonAsync("books", newBook);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Boken kunde inte sparas.";
                return;
            }

            BookDto? createdBook = await response.Content.ReadFromJsonAsync<BookDto>();

            if (createdBook is not null)
            {
                books ??= [];
                books.Add(createdBook);
            }

            newBook = new();
        }
        catch (HttpRequestException)
        {
            errorMessage = "Kunde inte kontakta API:et.";
        }
        finally
        {
            isSaving = false;
        }
    }
}
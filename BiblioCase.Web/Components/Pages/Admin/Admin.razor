
@page "/admin"

<PageTitle>Administration</PageTitle>

<h1>Administration</h1>

<p>Välkommen till BiblioCase administration.</p>

<div class="row g-3 mt-3">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Böcker</h2>
                <p class="card-text">
                    Lägg till, ändra och ta bort böcker.
                </p>
                <a href="/admin/books" class="btn btn-primary">
                    Hantera böcker
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 card-title">Författare</h2>
                <p class="card-text">
                    Hantera författare i bokkatalogen.
                </p>
                <a href="/admin/authors" class="btn btn-primary">
                    Hantera författare
                </a>
            </div>
        </div>
    </div>
</div>
